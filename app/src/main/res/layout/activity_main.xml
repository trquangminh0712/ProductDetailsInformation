<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF9F8"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutDescription="@xml/activity_main_xml_constraintlayout_scene">

        <EditText
            android:id="@+id/IDinput"
            android:layout_width="230dp"
            android:layout_height="55dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="50dp"
            android:background="@drawable/text_input_layout_background"
            android:hint="@string/input_the_product_id"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textColor="#1B1C1C"/>


        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:text="@string/submit"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/IDinput"
            app:layout_constraintStart_toEndOf="@id/IDinput" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="104dp"
            android:src="@drawable/thumbnail1"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="0dp" />

        <ImageView
            android:id="@+id/background1"
            android:layout_width="342dp"
            android:layout_height="264dp"
            android:layout_marginTop="566dp"
            android:src="@drawable/product_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.492"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/brand"
            android:text="@string/essence"
            app:layout_constraintTop_toTopOf="@id/background1"
            app:layout_constraintStart_toStartOf="@id/background1"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:textSize="12sp"
            android:textColor="#7B5455"/>

        <TextView
            android:id="@+id/product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/essence_mascara_lash_princess"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/brand"
            app:layout_constraintStart_toStartOf="@id/brand"
            android:textSize="32sp"
            android:textColor="#1B1C1C"
            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/reviewstars"
            app:layout_constraintTop_toBottomOf="@id/product_name"
            app:layout_constraintStart_toStartOf="@id/product_name"
            android:src="@drawable/review_stars"
            android:layout_marginTop="5dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/reviewpoint"
            android:text="@string/_4_94_3_reviews"
            app:layout_constraintTop_toBottomOf="@id/product_name"
            app:layout_constraintStart_toEndOf="@id/reviewstars"
            android:layout_marginTop="2dp"
            android:layout_marginStart="10dp"
            android:textSize="14sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/price_after_discount"
            android:text="@string/_9_99"
            app:layout_constraintTop_toBottomOf="@id/reviewstars"
            app:layout_constraintStart_toStartOf="@id/reviewstars"
            android:layout_marginTop="5dp"
            android:textSize="28sp"
            android:textColor="#7B5455"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/before_discount_price"
            android:text="@string/_10_76"
            app:layout_constraintTop_toBottomOf="@id/reviewstars"
            app:layout_constraintStart_toEndOf="@id/reviewstars"
            android:layout_marginTop="5dp"
            android:textSize="16sp"
            android:textColor="#504444"
            />
        <TextView
            android:layout_width="67dp"
            android:layout_height="16dp"
            android:id="@+id/percent_off"
            android:text="@string/_7_17_off"
            app:layout_constraintTop_toBottomOf="@id/reviewstars"
            app:layout_constraintStart_toEndOf="@id/before_discount_price"
            android:layout_marginTop="5dp"
            android:textSize="12sp"
            android:textColor="#93000A"
            android:background="#FFDAD6"
            android:layout_marginStart="10dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/availability_status"
            android:text="low in stock (5 products remains)"
            app:layout_constraintTop_toBottomOf="@id/price_after_discount"
            app:layout_constraintStart_toStartOf="@id/price_after_discount"
            android:layout_marginTop="5dp"
            android:textSize="12sp"
            android:textColor="#8C4B55"
            android:background="#E4E2E1"
            android:layout_marginStart="10dp"/>
        <ImageView
            android:id="@+id/background2"
            android:layout_width="342dp"
            android:layout_height="264dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/product_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.492"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/background1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/product_details"
            android:text="@string/product_details"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="@id/background2"
            app:layout_constraintStart_toStartOf="@id/background2"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:textColor="#1B1C1C" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/product_description"
            android:text="@string/product_description"
            android:textColor="#504444"
            app:layout_constraintTop_toBottomOf="@id/product_details"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintStart_toStartOf="@id/background2"
            app:layout_constraintEnd_toEndOf="@id/background2"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/sku"
            android:text="@string/sku"
            app:layout_constraintTop_toBottomOf="@id/product_description"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="@id/product_details"
            android:textColor="#504444"
            />
 <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/RCH45Q1A"
            android:text="@string/RCH45Q1A"
            app:layout_constraintTop_toBottomOf="@id/sku"
            android:textSize="16sp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/product_details"
            android:textColor="#1B1C1C"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/weight"
            android:text="@string/weight"
            app:layout_constraintTop_toBottomOf="@id/product_description"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toEndOf="@id/product_details"
            android:textColor="#504444"
            />
 <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/twogram"
            android:text="@string/twograms"
            app:layout_constraintTop_toBottomOf="@id/sku"
            android:textSize="16sp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toEndOf="@id/product_details"
            android:textColor="#1B1C1C"
            />
        <ImageView
            android:id="@+id/background3"
            android:layout_width="342dp"
            android:layout_height="237dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/product_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.492"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/background2" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/policy"
            android:text="@string/policy"
            app:layout_constraintTop_toTopOf="@id/background3"
            app:layout_constraintStart_toStartOf="@id/background3"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:textSize="20sp"
            android:textColor="#1B1C1C"
            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/deliver_image"
            android:src="@drawable/deliver"
            app:layout_constraintTop_toBottomOf="@id/policy"
            app:layout_constraintStart_toStartOf="@id/policy"
            android:layout_marginTop="20dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/deliver_text"
            android:text="@string/deliver"
            app:layout_constraintStart_toEndOf="@id/deliver_image"
            app:layout_constraintBottom_toBottomOf="@id/deliver_image"
            android:layout_marginStart="20dp"
            android:textSize="14sp"
            android:textColor="#1B1C1C"
            />
  <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/deliver_details"
            android:text="@string/ships_in_1_month"
            app:layout_constraintStart_toEndOf="@id/deliver_image"
            app:layout_constraintTop_toBottomOf="@id/deliver_text"
            android:layout_marginStart="20dp"
            android:textSize="14sp"
            android:textColor="#504444"
            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/warranty_image"
            android:src="@drawable/warranty"
            app:layout_constraintTop_toBottomOf="@id/deliver_image"
            app:layout_constraintStart_toStartOf="@id/policy"
            android:layout_marginTop="30dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/warranty_text"
            android:text="@string/warranty"
            app:layout_constraintStart_toEndOf="@id/warranty_image"
            app:layout_constraintBottom_toBottomOf="@id/warranty_image"
            android:layout_marginStart="20dp"
            android:textSize="14sp"
            android:textColor="#1B1C1C"
            />
  <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/warranty_details"
            android:text="@string/_1_month"
            app:layout_constraintStart_toEndOf="@id/warranty_image"
            app:layout_constraintTop_toBottomOf="@id/warranty_image"
            android:layout_marginStart="20dp"
            android:textSize="14sp"
            android:textColor="#504444"
            />
 <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/return_and_exchange_image"
            android:src="@drawable/return_and_exchange"
            app:layout_constraintTop_toBottomOf="@id/warranty_image"
            app:layout_constraintStart_toStartOf="@id/policy"
            android:layout_marginTop="30dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/return_and_exchange_text"
            android:text="@string/return_and_exchange"
            app:layout_constraintStart_toEndOf="@id/return_and_exchange_image"
            app:layout_constraintBottom_toBottomOf="@id/return_and_exchange_image"
            android:layout_marginStart="20dp"
            android:textSize="14sp"
            android:textColor="#1B1C1C"
            />
  <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/return_and_exchange_details"
            android:text="30 days return policy"
            app:layout_constraintStart_toEndOf="@id/return_and_exchange_image"
            app:layout_constraintTop_toBottomOf="@id/return_and_exchange_image"
            android:layout_marginStart="20dp"
            android:textSize="14sp"
            android:textColor="#504444"
            />
        <ImageView
            android:id="@+id/background4"
            android:layout_width="342dp"
            android:layout_height="264dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/product_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.492"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/background3" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/comments"
            android:id="@+id/comments"
            app:layout_constraintTop_toTopOf="@id/background4"
            app:layout_constraintStart_toStartOf="@id/background4"
            android:layout_marginStart="30dp"
            android:layout_marginTop="30dp"
            android:textColor="#1B1C1C"
            android:textSize="20sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/view_all"
            android:id="@+id/view_all"
            app:layout_constraintStart_toEndOf="@id/comments"
            app:layout_constraintBottom_toBottomOf="@id/comments"
            android:textSize="14sp"
            android:layout_marginStart="120dp"
            android:textColor="#7B5455"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/Name1"
            android:text="@string/john_doe"
            app:layout_constraintTop_toBottomOf="@id/comments"
            app:layout_constraintStart_toStartOf="@id/comments"
            android:layout_marginTop="20dp"
            android:textColor="#1B1C1C"
            android:textSize="14sp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/comment_1"
            android:text="@string/very_unhappy_with_my_purchase"
            app:layout_constraintStart_toStartOf="@id/Name1"
            app:layout_constraintTop_toBottomOf="@id/Name1"
            android:textSize="14sp"
            android:textColor="#504444" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/star1"
            android:src="@drawable/star1"
            app:layout_constraintBottom_toBottomOf="@id/Name1"
            app:layout_constraintEnd_toEndOf="@id/background4"
            android:layout_marginEnd="20dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/Name2"
            android:text="@string/nolan_gonzalez"
            app:layout_constraintTop_toBottomOf="@id/Name1"
            app:layout_constraintStart_toStartOf="@id/comments"
            android:layout_marginTop="50dp"
            android:textColor="#1B1C1C"
            android:textSize="14sp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/comment_2"
            android:text="@string/not_as_described"
            app:layout_constraintStart_toStartOf="@id/Name2"
            app:layout_constraintTop_toBottomOf="@id/Name2"
            android:textSize="14sp"
            android:textColor="#504444" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/star2"
            android:src="@drawable/star1"
            app:layout_constraintBottom_toBottomOf="@id/Name2"
            app:layout_constraintStart_toStartOf="@id/star1"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/Name3"
            android:text="@string/scarlett_wright"
            app:layout_constraintTop_toBottomOf="@id/Name2"
            app:layout_constraintStart_toStartOf="@id/comments"
            android:layout_marginTop="50dp"
            android:textColor="#1B1C1C"
            android:textSize="14sp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/comment_3"
            android:text="@string/very_satisfied"
            app:layout_constraintStart_toStartOf="@id/Name3"
            app:layout_constraintTop_toBottomOf="@id/Name3"
            android:textSize="14sp"
            android:textColor="#504444" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/star3"
            android:src="@drawable/star3"
            app:layout_constraintBottom_toBottomOf="@id/Name3"
            app:layout_constraintStart_toStartOf="@id/star2"
            />
        <Button
            android:layout_width="164dp"
            android:layout_height="52dp"
            android:id="@+id/add_to_cart"
            app:layout_constraintTop_toBottomOf="@id/background4"
            app:layout_constraintStart_toStartOf="@id/background4"
            android:layout_marginStart="0dp"
            android:layout_marginTop="20dp"
            android:text="@string/add_to_cart"
            android:textSize="15sp"
            android:background="@drawable/add_to_cart" />
        <Button
            android:layout_width="164dp"
            android:layout_height="52dp"
            android:id="@+id/buy_now"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/background4"
            app:layout_constraintStart_toEndOf="@id/add_to_cart"
            android:layout_marginStart="20dp"
            android:text="@string/buy_now"
            android:background="@drawable/buynow"
            android:textSize="15sp"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
